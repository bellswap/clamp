{
  "name": "bellswap-v2-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run lint:naming && bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "bun test src scripts",
    "lint:naming": "bun run scripts/naming-lint.ts",
    "dev:mock": "VITE_MOCK=1 vite",
    "shots": "bun run scripts/shots.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "happy-dom": "20.14.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
