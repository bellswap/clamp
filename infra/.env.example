# Template for infra/.env on the VM (/opt/bellswap-v2/infra/.env, mode 600). deploy.sh writes the real file on the
# VM on first run; it is never committed or copied back except the admin token (deploy/.admin-token, mode 600).
# Fork of Robinhood Chain near head (cast block-number --rpc-url https://robinhood.drpc.org minus 20; first fork block 91940072).
ANVIL_FORK_BLOCK=91989489
ANVIL_UPSTREAM=https://robinhood.drpc.org
# anvil dev account 1 (public test key, playground only).
BELL_SIGNER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Random 24 bytes hex, generated on the VM by deploy.sh (openssl rand -hex 24).
BELL_ADMIN_TOKEN=
# Optional: allowed origins for the bell service (empty: the service default).
# BELL_ORIGINS=
# Dockerfile path relative to services/bell; default ../../infra/bell/Dockerfile.
# BELL_DOCKERFILE=Dockerfile
# Transactions kept by anvil, in blocks (--transaction-block-keeper). Default 7200 in docker-compose.yml; set it
# empty (ANVIL_TX_BLOCK_KEEPER=) to run without the flag.
# ANVIL_TX_BLOCK_KEEPER=7200
# Faucet calls per client IP per hour (default 1000 in docker-compose.yml).
# BELL_FAUCET_IP_MAX=1000
# rpc-guard: reference addresses to protect and contracts a raw transaction may call (comma-separated). The compose
# defaults are the deployments/book.json demoSigner and book, vault, usdg; an empty value keeps the default.
# RPC_GUARD_REF=0x980ea9f1a0C36e1E5f3B6BD451bEf8a7Fe661f97
# RPC_GUARD_TARGETS=0xA2Ec435D67B35893b81a87212815DCDd20EE4f9B,0xB8357F7f41125d4b24AD052c1b7288BeF5C43446,0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Demo trader fleet (compose profile bell, service bots). Generate on the VM, never print it:
#   echo "BOTS_MNEMONIC=$(cast wallet new-mnemonic --json | jq -r .mnemonic)" >> .env
BOTS_MNEMONIC=
# 1 starts trading; 0 keeps the fleet idle (kill switch: docker compose stop bots).
BOTS_ENABLED=0
# BOTS_COUNT=24
# BOTS_LP=4
# BOTS_INTERVAL_MS=3000
